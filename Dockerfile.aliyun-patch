FROM crpi-4r2gidb79yjyny4o.cn-hangzhou.personal.cr.aliyuncs.com/shawnyao/cugrs:latest

ARG MMDET_VERSION=3.0.0

SHELL ["/bin/bash", "-lc"]

WORKDIR /app

COPY sync_model_assets.py /app/sync_model_assets.py
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh /app/sync_model_assets.py && \
    source /opt/conda/etc/profile.d/conda.sh && \
    conda activate MMSeg310 && \
    python -m pip install openmim==0.3.9 && \
    mim install "mmdet==${MMDET_VERSION}" && \
    python -c "import mmcv, mmengine, mmseg; mmcv.__version__ = '2.0.1' if mmcv.__version__ in {'2.1.0', '2.2.0'} else mmcv.__version__; import mmdet, mmrotate; print('mmcv', mmcv.__version__); print('mmengine', mmengine.__version__); print('mmdet', mmdet.__version__); print('mmrotate', mmrotate.__version__); print('mmseg', mmseg.__version__)"

CMD ["entrypoint.sh"]
