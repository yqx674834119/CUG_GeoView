FRONTEND_IMAGE=geoview-frontend:latest
FRONTEND_PORT=3000

# Preferred: set the full backend URL directly after the backend service is deployed.
# Example: GEOVIEW_BACKEND_URL=http://192.168.1.25:5008
GEOVIEW_BACKEND_URL=

# Optional fallback when GEOVIEW_BACKEND_URL is empty.
# If GEOVIEW_BACKEND_HOST is also empty, the frontend will use the browser hostname.
GEOVIEW_BACKEND_PROTOCOL=http
GEOVIEW_BACKEND_HOST=
GEOVIEW_BACKEND_PORT=5008

GEOVIEW_MINER_ENABLED=false
GEOVIEW_MINER_URL=
GEOVIEW_BAIDU_MAP_ACCESS_KEY=
